{
  "name": "auraflow-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AuraFlow Web — a fast, privacy-first local file toolkit: organize, convert, build PDFs and merge PDFs in your browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tools": "node scripts/tools-test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright": "^1.55.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  }
}
